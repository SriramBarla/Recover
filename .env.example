# Recover environment variables (BUILD-CONTRACT.md section 10). Names and purposes only, no values.
# Local development: run `node scripts/dev-env.mjs` to generate apps/web/.env.local,
# apps/worker/.env.local and .env.local from the running local Supabase stack.
# Production: set these in the two Vercel projects. The web project must never hold any SUPABASE_S3_* value.

# ---------- recover-web (apps/web) ----------
DATABASE_URL=                   # pooler URL for the recover_web login (function-only grants)
DATABASE_SSL=                   # require (production) | disable (local)
WEB_ORIGIN=                     # e.g. https://recover.<district>.org; Origin checks for student mutations
AUTH_SECRET=                    # Auth.js session secret (32 random bytes, base64url)
AUTH_URL=                       # https://<web origin>/api/auth
AUTH_TRUST_HOST=                # true behind Vercel
AUTH_GOOGLE_ID=                 # Google OAuth client id (district Workspace)
AUTH_GOOGLE_SECRET=             # Google OAuth client secret
RECOVER_DEV_LOGIN=              # 1 enables the dev-only sign-in; refused on Vercel. Leave unset in production.
RECOVER_DEV_AUTH=               # 1 enables the dev-only web->worker secret; refused on Vercel. Leave unset in production.
STAFF_ASSERTION_KEY_CURRENT=    # 32-byte base64url HMAC key; the same value is in Vault as staff_assertion_key_v<N>
STAFF_ASSERTION_KEY_VERSION=    # N (Vault pointer staff_assertion_key_current must equal it)
DEVICE_KEY_V1=                  # device digest HMAC key (base64url 32 bytes)
IP_KEY=                         # IP correlation HMAC key (monthly subkeys)
SEARCH_KEY=                     # search query HMAC key (monthly subkeys)
WORKER_URL=                     # https://<recover-worker deployment>
WORKER_DEV_SECRET=              # local only (web->worker dev auth)
WORKER_OIDC_AUDIENCE=           # production: custom OIDC audience the worker pins
STORAGE_PUBLIC_URL=             # https://<project>.supabase.co/storage/v1/object/public
S3_ORIGIN=                      # https://<project>.supabase.co (CSP connect-src for presigned uploads)
REVALIDATE_SECRET_SHA256=       # sha256 hex of the worker's REVALIDATE_SECRET
READY_SECRET_SHA256=            # sha256 hex of the scheduler's readiness bearer

# ---------- recover-worker (apps/worker) ----------
# DATABASE_URL / DATABASE_SSL   # pooler URL for the recover_worker login (system_* functions only)
SUPABASE_S3_ENDPOINT=           # https://<project>.supabase.co/storage/v1/s3   (worker only: Storage root)
SUPABASE_S3_REGION=             # as documented for the project
SUPABASE_S3_ACCESS_KEY_ID=      # worker only
SUPABASE_S3_SECRET_ACCESS_KEY=  # worker only
CONTENT_KEY=                    # content fingerprint HMAC key
SCHEDULER_BEARER_SHA256=        # sha256 hex of the pg_cron drain's scheduler bearer (bearer itself lives in Vault)
WEB_OIDC_ISSUER=                # https://oidc.vercel.com/<team>
WEB_OIDC_AUDIENCE=              # custom audience for recover-web tokens
WEB_PROJECT_ID=                 # Vercel project id of recover-web
WEB_OWNER_ID=                   # Vercel team id
VISION_MODE=                    # google | mock | off
GCP_WIF_AUDIENCE=               # //iam.googleapis.com/projects/<n>/locations/global/workloadIdentityPools/<pool>/providers/<provider>
GCP_SERVICE_ACCOUNT_EMAIL=      # service account impersonated through WIF (no JSON key)
GCP_PROJECT_ID=                 # district GCP project
WEB_URL=                        # https://<web origin> (cache revalidation target)
REVALIDATE_SECRET=              # bearer for POST /api/internal/revalidate

# ---------- local tooling (.env.local at the repo root) ----------
# DB_URL, SCHEDULER_BEARER, READY_SECRET: used by scripts/dev.mjs and the integration tests.
